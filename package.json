{
  "name": "@tscircuit/system-block-viewer",
  "version": "0.0.2",
  "description": "React viewer for system block diagrams in Circuit JSON",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/system-block-viewer"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "cosmos",
    "build": "tsup lib/index.ts --format esm --dts --sourcemap --external react",
    "build:site": "cosmos-export",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "circuit-json": "^0.0.543",
    "circuit-to-svg": "^0.0.455",
    "transformation-matrix": "^3.0.0",
    "use-mouse-matrix-transform": "^1.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-cosmos": "^6.2.1",
    "react-cosmos-plugin-vite": "^6.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "pver": "0.0.43"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
